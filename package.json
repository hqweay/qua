{
  "name": "qua",
  "version": "0.1.0",
  "type": "module",
  "description": "相（Qua）：块级 DOM 大纲笔记 ＋ 自研区间锚点 ＋ 命令/绑定表；Electron 壳，主进程不含业务逻辑",
  "author": "hqweay",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=26"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --port 5180 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck:electron": "tsc -p tsconfig.electron.json",
    "build:mac": "pnpm build && pnpm build:electron && node scripts/build-mac.mjs",
    "preview": "vite preview --port 5180 --strictPort",
    "shots": "node scripts/screenshot.mjs",
    "check": "pnpm typecheck:electron && pnpm build && node checks/smoke.mjs",
    "check:electron": "node checks/electron-smoke.mjs",
    "check:dock": "node checks/dock-smoke.mjs",
    "check:bundle": "node checks/bundle-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json",
    "arch:check": "node scripts/arch-check.mjs",
    "test:core": "node --test tests/*.test.ts",
    "gate:web": "pnpm typecheck && pnpm test:core && pnpm build && pnpm arch:check && pnpm check && pnpm check:dock",
    "gate": "pnpm gate:web && pnpm build:electron && pnpm check:electron",
    "gate:bundle": "pnpm gate && pnpm check:bundle"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.49.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "net.leay.qua",
    "productName": "相",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/userdata/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
